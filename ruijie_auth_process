#pragma endian big

do dhcp

dest address = 01:d0:f8:00:00:03

with retry (default 3) {
    reply1 = with timeout (default 3s) {
        send ether packet (
            to dest address
            with type pae (0x888e)
        ) {
            u8 8021x version 1
            u8 8021x packet type eapol start (0x1)
            u16 8021x packet length 0x00
            private properties {
                apply transform foreach (u8 b) {
                    return (
                        ((~b & 0x10) >> 1) |
                        ((~b & 0x20) >> 3) |
                        ((~b & 0x40) >> 5) |
                        ((~b & 0x80) >> 7) |
                        ((~b & 0x08) << 1) |
                        ((~b & 0x04) << 3) |
                        ((~b & 0x02) << 5) |
                        ((~b & 0x01) << 7)
                    )
                } {
                    u32 0x1311
                    u8 <dhcp enabled> (default 0x01)
                    u32 <ipv4 addr>
                    u32 <netmask>
                    u32 <gateway>
                    u32 <dns>
                    u16 <crc16 of the above 21 bytes>
                }
                {
                    u32 0x1311
                    pad to 32 bytes with null {
                        apply transform utf8-to-gbk {
                            string "8021x.exe" (app name)   
                        }
                    }
                }
                {
                    u8 <major ver> (default 0x01)
                    u8 <minor ver> (default 0x1e)
                    u8 0x01
                    u8 0x02
                }
                {
                    u8 0x00 // logoff reason
                    u32 0x1311
                    u8 0x00
                    u8 0x00
                }
#define make_private_property(length, type) \
    { \
        u8 0x1A \
        u8 length + 8 \
        u32 0x1311 \
        u8 type \
        u8 length + 2 \
    }
                make_private_property(4, 0x18) {
                    u32 <dhcp enabled> (default 0x01)
                }
                make_private_property(6, 0x2D) {
                    u8[6] <adapter mac addr>
                }
                make_private_property(0, 0x2F) {
                }
                make_private_property(<alternative dnses string length> + 1, 0x76) {
                    string <null terminated semicolon separated alternative dnses>
                }
                make_private_property(1, 0x35) {
                    u8 <ipv6 addr count>
                }
                make_private_property(16, 0x36) {
                    u128 0x00
                }
                make_private_property(16, 0x38) {
                    u128 <ipv6 link local addr>
                }
                make_private_property(16, 0x4E) {
                    u128 <ipv6 global addr>
                }
                make_private_property(128, 0x4D) {
                    string "cedfeb1d7f714546e57ca23b56e1888b1c576780b68da2764b2da9badf68fe79130740975965232c5a5e36b00c09401d0fd81179a318b66587ff9e49aa98f5d0"
                    /*
                     *  calculated by:
                     *  the vz whirlpool of {
                     *      the vz md5 of g_pAppData @ src/global.cpp +
                     *      "0" * 15 +
                     *      the vz md5 of g_pDllData @ src/global.cpp +
                     *      "0" * 15
                     *  }
                     */
                }
                make_private_property(32, 0x39) {
                    pad to 32 bytes with null {
                        apply transform utf8-to-gbk {
                            string <service name> (empty when unknown)
                        }
                    }
                }
                make_private_property(64, 0x54) {
                    pad to 64 bytes with null {
                        string <disk id>
                    }
                }
                make_private_property(<sec domain name string length>, 0x55) {
                    apply transform utf8-to-gbk {
                        string <sec domain name>
                    }
                }
                make_private_property(1, 0x62) {
                    u8 0
                }
                make_private_property(1, 0x70) {
                    u8 Is64BIT() ? 64 : 32 // I intentionally don't use hexadecimal
                }
                make_private_property(<version code string length> + 1, 0x6F) {
                    string <null terminated version code string length>
                }
                make_private_property(1, 0x79) {
                    u8 0x02
                }
#undef make_private_property
            }
        }
    }

    dest address = reply1.srcaddr

    switch reply1.eap_code {
        case request:
            switch reply1.eap_type {
                case identity:
                    success()
                    break

                case notification:
                    show_message(reply1.eap_notification)
                    [[fallthrough]]

                case nak:
                case otp:
                case gtc:
                    send ether packet (
                        to dest address
                        with type pae (0x888e)
                    ) {
                        u8 8021x version 1
                        u8 8021x packet type eap packet (0x0)
                        u16 8021x packet length 0x05
                        u8 eap packet code response (0x02)
                        u8 eap packet id reply1.eap_id
                        u16 eap packet length 0x05
                        u8 eap packet type nak (0x03)
                        private properties same as above packet's
                    }
                    break

                default:
                    break
            }
            break

        case failure:
            define bytes after reply1.eap_length as {
                u32 0x1311
                u16 length
                apply transform gbk-to-utf8 {
                    u8[length] reason
                }
            } with name rj_failure
            show_message(reply1.rj_failure.reason)
            fail()
            break

        default:
            break
    }
}

// now we've ensured we've received a eap packet with type identity
with retry {
    reply2 = with timeout (default 45s) {
        send ether packet (
            to dest address
            with type pae (0x888e)
        ) {
            u8 8021x version 1
            u8 8021x packet type eap packet (0x00)
            u16 8021x packet length 4 + <username length>
            u8 eap packet code response (0x02)
            u8 eap packet id reply1.eap_id
            u16 eap packet length 4 + <username length>
            u8 eap packet type identity (0x01)
            string <username>
            private properties same as first packet
        }
    }

    switch reply2.eap_code {
        case request:
            switch reply2.eap_type {
                case md5:
                    md5challenge = reply2.md5data
                    if not md5challenge {
                        raise notimplmentederror
                    }
                    if additional data after reply2.md5data {
                        define bytes after reply2.md5data as {
                            u32 0x1311
                            u8 0x2E
                            u8 0x03
                            u8 should_encrypt_password_in_md5_response
                            u32 0x1311
                            u8 0x66
                            u8 <service list length> + 2
                            apply transform gbk-to-utf8 {
                                u8[<service list length>] <@-separated service names>
                            }
                        }
                    }
                    success()
                    break

                case notification:
                    show_message(reply2.eap_notification)
                    [[fallthrough]]

                case nak:
                case otp:
                case gtc:
                    send ether packet (
                        to dest address
                        with type pae (0x888e)
                    ) {
                        u8 8021x version 1
                        u8 8021x packet type eap packet (0x0)
                        u16 8021x packet length 0x05
                        u8 eap packet code response (0x02)
                        u8 eap packet id reply2.eap_id
                        u16 eap packet length 0x05
                        u8 eap packet type nak (0x03)
                        private properties same as above packet's
                    }
                    break

                default:
                    break
            }
            break

        case failure:
            define bytes after reply2.eap_length as {
                u32 0x1311
                u16 length
                apply transform gbk-to-utf8 {
                    u8[length] reason
                }
            } with name rj_failure
            show_message(reply2.rj_failure.reason)
            fail()
            break

        default:
            break
    }
}

with retry {
    reply3 = with timeout (default 3s) {
        send ether packet (
            to dest address
            with type pae (0x888e)
        ) {
            u8 8021x version 1
            u8 8021x packet type eap packet (0x0)
            u16 8021x packet length 22 + <username length>
            u8 eap packet code response (0x2)
            u8 eap packet id reply2.id
            u16 eap packet length 22 + <username length>
            u8 eap packet type md5 challenge (0x4)
            u8 eap md5 value length 0x10
            u8[] eap md5 value = {
                the md5sum of {
                    reply2.id
                    <password>
                    md5challenge
                }
            }
            string <username>
            private properties {
                apply transform foreach (u8 b) {
                    return (
                        ((~b & 0x10) >> 1) |
                        ((~b & 0x20) >> 3) |
                        ((~b & 0x40) >> 5) |
                        ((~b & 0x80) >> 7) |
                        ((~b & 0x08) << 1) |
                        ((~b & 0x04) << 3) |
                        ((~b & 0x02) << 5) |
                        ((~b & 0x01) << 7)
                    )
                } to {
                    u32 0x1311
                    u8 <dhcp enabled> (default 0x01)
                    u32 <ipv4 addr>
                    u32 <netmask>
                    u32 <gateway>
                    u32 <dns>
                    u16 <crc16 of the above 21 bytes>
                }
                {
                    u32 0x1311
                    pad to 32 bytes with null {
                        apply transform utf8-to-gbk {
                            string "8021x.exe" (app name)
                        }
                    }
                }
                {
                    u8 <major ver> (default 0x01)
                    u8 <minor ver> (default 0x1e)
                    u8 0x01
                    u8 0x02
                }
                {
                    u8 0x00 // logoff reason
                    u32 0x1311
                    u8 0x00
                    u8 0x00
                }
#define make_private_property(length, type) \
    { \
        u8 0x1A \
        u8 length + 8 \
        u32 0x1311 \
        u8 type \
        u8 length + 2 \
    }
                make_private_property(4, 0x18) {
                    u32 <dhcp enabled> (default 0x01)
                }
                make_private_property(6, 0x2D) {
                    u8[6] <adapter mac addr>
                }
                if should_encrypt_password_in_md5_response {
                    make_private_property(<see below (outbuf's length)>, 0x2F) {
                        func {
                            outbuf = ""
                            password = pad password into 16 byte boundary
                            group = split password into 16 char
                            md5buf = md5challenge
                            foreach i in group {
                                md5buf = md5sum(<username> + md5buf) ^ i
                                outbuf += md5buf
                            }
                            return outbuf
                        }
                    }
                }
                make_private_property(<alternative dnses string length> + 1, 0x76) {
                    string <null terminated semicolon separated alternative dnses>
                }
                make_private_property(1, 0x35) {
                    u8 <ipv6 addr count>
                }
                make_private_property(16, 0x36) {
                    u128 0x00
                }
                make_private_property(16, 0x38) {
                    u128 <ipv6 link local addr>
                }
                make_private_property(16, 0x4E) {
                    u128 <ipv6 global addr>
                }
                make_private_property(128, 0x4D) {
                    // unless noted, all "ascii hex" are in lowercase
                    vz whirlpool as ascii hex of func {
                        switch (md5challenge[0] + md5challenge[3]) % 5 {
                            case 0:
                                return (
                                    vz md5 of appdata as ascii hex +
                                    (even bytes of md5challenge) as ascii hex +
                                    vz md5 of dlldata as ascii hex +
                                    (odd bytes of md5challenge) as ascii hex
                                )
                            case 1:
                                return (
                                    vz sha1 of dlldata +
                                    md5challenge[:6] +
                                    vz sha1 of appdata +
                                    md5challenge[6:]
                                )
                            case 2:
                                return (
                                    vz sha1 of dlldata +
                                    md5challenge[:6] +
                                    vz ripemd128 of appdata +
                                    md5challenge[6:]
                                )
                            case 3:
                                return (
                                    vz tiger of appdata +
                                    md5challenge[:10] + // !!!
                                    vz ripemd128 of dlldata +
                                    md5challenge[10:]
                                )
                            case 4:
                                return (
                                    vz tiger of appdata +
                                    md5challenge[:8] + // !!!
                                    vz sha1 of dlldata +
                                    md5challenge[8:]
                                )
                        }
                    }
                }
                make_private_property(32, 0x39) {
                    pad to 32 bytes with null {
                        apply transform utf8-to-gbk {
                            string <service name> (empty when unknown)
                        }
                    }
                }
                make_private_property(64, 0x54) {
                    pad to 64 bytes with null {
                        string <disk id>
                    }
                }
                make_private_property(<sec domain name string length>, 0x55) {
                    apply transform utf8-to-gbk {
                        string <sec domain name>
                    }
                }
                make_private_property(1, 0x62) {
                    u8 0
                }
                make_private_property(1, 0x70) {
                    u8 Is64BIT() ? 64 : 32 // I intentionally don't use hexadecimal
                }
                make_private_property(<version code string length> + 1, 0x6F) {
                    string <null terminated version code string length>
                }
                make_private_property(1, 0x79) {
                    u8 0x02
                }
#undef make_private_property
            }
        }
    }

    switch reply3.eap_code {
        case success:
            parse reply3.success_data as {
                {
                    u32 0x1311
                    u16 length
                    apply transform gbk-to-utf8 {
                        u8[length] notification
                    }
                }
                {
                    u32 0x1311
                    u16 length
                    u32 latest version
                    u8[length - 4] 0x00
                }
                {
                    u32 0x1311
                    u8 proxy detect valid
                    u8 proxy detect enabled
                }
                {
                    u32 0x1311
                    u8 dont know flag 1
                    u8 dont know flag 2
                }
                apply transform foreach (u8 b) {
                    return (
                        ((~b & 0x10) >> 1) |
                        ((~b & 0x20) >> 3) |
                        ((~b & 0x40) >> 5) |
                        ((~b & 0x80) >> 7) |
                        ((~b & 0x08) << 1) |
                        ((~b & 0x04) << 3) |
                        ((~b & 0x02) << 5) |
                        ((~b & 0x01) << 7)
                    )
                } {
                    u32 0x1311
                    u8 0x0a
                    u8 hello enabled
                    u32 hello id
                    u32 hello interval (in sec)
                    padding u8
                }
                { // []
                    u32 0x1311
                    u8 type
                    u8 length
                    switch type {
                        case 0x37:
                            u8[length - 2] upgrade url
                            break
                        case 0x3c: // account info
                        case 0x3d: // personal info
                            notification += apply transform gbk-to-utf8 {
                                u8[length - 2]
                            }
                            break
                        case 0x56:
                            u32 reconnect interval (in mins)
                            break
                        case 0x59:
                            u32 sam hello interval (in secs)
                            break
                        case 0x5A:
                            u32 sam port
                            break
                        case 0x5B:
                            u32 sam ip addr
                            break
                        case 0x5C:
                            decrypt with modified rc4 (
                                key "com.ruijie.www"
                            ) {
                                u8[8] sam encrypt key
                            }
                            break
                        case 0x5D:
                            decrypt with modified rc4 (
                                key "com.ruijie.www"
                            ) {
                                u8[8] sam encrypt iv
                            }
                            break
                        case 0x5E:
                            u64 sam server utc timestamp
                            break
                        case 0x61:
                            u8 0x09 // radius type, we only support sam
                            break
                        case 0x65:
                            u8[length - 2] service switch result
                            break
                        case 0x66:
                            apply transform gbk-to-utf8 {
                                u8[length - 2] @-separated service names
                            }
                            break
                        case 0x68:
                            u8[length - 2] user login url
                            break
                        case 0x6E:
                            u32 msg client port
                            break
                        case 0x72:
                            u8[length - 2] utrust url
                            break
                        case 0x74:
                            u32 proxy detect types
                            break
                        case 0x77:
                            u8 is show utrust url
                            u16 show utrust delay (in sec)
                            break
                        case 0x79:
                            u8 direct communication highest version supported
                            break
                        case 0x80:
                            u8 direct communication heartbeat flags
                            break
                        default:
                            break
                    }
                }[]
            }
        case failure:
            define bytes after reply3.eap_length as {
                u32 0x1311
                u16 length
                apply transform gbk-to-utf8 {
                    u8[length] reason
                }
            } with name rj_failure
            show_message(reply3.rj_failure.reason)
            fail()
            break

        default:
            break
    }
}

if radius type == 9 && latest version > our version {
    download(upgrade url)
    upgrade
}

if hello enabled {
    send times = 0
    while true { // &
        send times++
        send ether packet (
            to dest address
            with type pae (0x888e)
        ) {
            u8 8021x version 1
            u8 8021x packet type 0xbf
            u16 8021x packet length 30

            apply transform foreach (u8 b) {
                return (
                    ((~b & 0x10) >> 1) |
                    ((~b & 0x20) >> 3) |
                    ((~b & 0x40) >> 5) |
                    ((~b & 0x80) >> 7) |
                    ((~b & 0x08) << 1) |
                    ((~b & 0x04) << 3) |
                    ((~b & 0x02) << 5) |
                    ((~b & 0x01) << 7)
                )
            } {
                {
                    u32 0x1311
                    u8 0x01
                    u8 0x06
                    u32 hello id + send times
                }
                {
                    u32 0x1311
                    u8 0x01
                    u8 0x06
                    u32 send times
                }
                {
                    u32 0x1311
                    u8 0x01
                    u8 0x03
                    u8 0
                }
            }
        }
        sleep(hello interval)
    } &
}

direct { // &
    expect version = max(2, direct communication highest version supported)
    next session id = 1
    func send direct udp packet (buffer, need reply) {
        id = 1
        total length = buffer length
        while (buffer) {
            send length = min(1358, buffer length)
            send udp packet (
                to sam ip addr
                port sam port
            ) {
                { // header
                    u8 version expect version
                    u8 request (0x1)
                    u32 id id++
                    u16 send length + 0x2A
                    u8[16] md5sum of {
                        whole packet with md5sum field to all 0
                        sam encrypt key
                        sam encrypt iv
                    }
                    u32 session id next session id++
                    u64 timestamp ++sam server utc timestamp
                    u8 0x1
                    if total legnth <= 1300 {
                        u8 0x1
                    } else {
                        if first packet {
                            u8 0x2
                        } else if last packet {
                            u8 0x4
                        } else {
                            u8 0x3
                        }
                    }
                    u32 total length
                }
                { // data
                    u8[] buffer[:send length]
                }
            }
            if not need reply {
                return
            }
            for _ in 0..(default 2) {
                with timeout (default 3s) {
                    reply = get one packet
                            from reply queue of listen thread
                }
                parse reply as {
                    u8 sent.version
                    u8 response (0x2)
                    u32 sent.id
                    u16 0x2A
                    u8[16] md5sum of {
                        whole packet with md5sum field to all 0
                        sam encrypt key
                        sam encrypt iv
                    }
                    u32 sent.session id
                    u64 timestamp { timestamp > sent.timestamp }
                    u8 0x1
                    u8 0x1
                    u32 0x0
                }
                if parse failed {
                    continue
                }
                yield reply
                break
            }
            buffer = buffer[send length:]
        }
    }
    udp listen thread { // &
        request = []
        reply = []
        while true {
            packet = listen udp packet from sam ip addr port sam port
            parse reply as {
                u8 padding
                u8 type
            }
            switch type {
                case request:
                    put to request queue
                    break
                case reply:
                    put to reply queue
                    break
            }
        }
    } &
    direct process thread { // &
        last timestamp = 0
        next packet id = 0
        data = []
        while true {
            reply = get one packet
                    from request queue of listen thread
            parse reply as {
                {
                    u8 expect version
                    u8 reply (0x1)
                    u32 id
                    u16 data length + 0x2A
                    u8[16] md5sum of {
                        whole packet with md5sum field to all 0
                        sam encrypt key
                        sam encrypt iv
                    }
                    u32 session id
                    u64 timestamp
                    u8 0x1
                    u8 slice type
                    u32 total data length
                }
                {
                    u8[data length] data
                }
            }
            if parse failed {
                error
            }
            if reply.id == 1 && reply.slice type in (multi middle, multi end) {
                error
            }
            if timestamp <= last timestamp {
                error
            }
            last timestamp = timestamp
            if next packet id && reply.id == 1 {
                error
            }
            if next packet id == reply.id {
                error
            }
            next packet id++
            if next packet id != reply.id {
                error
            }
            data += reply.data
            if reply.slice type == multi end {
                if total data length != data.length {
                    retard
                    error
                }

                data = with des decrypt (
                    cbc mode
                    key sam encrypt key
                    iv sam encrypt iv
                ) {
                    data
                }

                send udp packet (
                    to sam ip addr
                    port sam port
                ) {
                    { // header
                        u8 version expect version
                        u8 response (0x2)
                        u32 reply.id
                        u16 0x2A
                        u8[16] md5sum of {
                            whole packet with md5sum field to all 0
                            sam encrypt key
                            sam encrypt iv
                        }
                        u32 reply.session id
                        u64 timestamp ++sam server utc timestamp
                        u8 0x1
                        u8 0x1
                        u32 0x0
                    }
                }

                parse data as { // []
                    u8 0x1
                    u8 total length
                    u16 type
                    u8 length
                    switch type {
                        case 0x0102:
                            notify user {
                                apply transform gbk-to-utf8 {
                                    u8[length] data
                                }
                            }
                            break
                        case 0x0306:
                            // simulate su logoff?
                            raise notimplementederror
                            break
                        case 0x0508:
                            notify user force offline {
                                apply transform gbk-to-utf8 {
                                    u8[length] data
                                } || (default notification)
                            }
                            logout reason = force offline (120)
                            request log off
                            break
                        case 0x070A:
                            // service switch result
                            raise notimplementederror
                            break
                        default:
                            break
                    }
                }[]
            }
        }
    } &
    hello thread { // &
        if sam hello interval == 0 {
            return
        }

        while true {
            sleep(sam hello interval)
            send direct udp packet {
                with des encrypt (
                    cbc mode
                    key sam encrypt key
                    iv sam encrypt iv
                ) {
                    {
                        u8 0x1
                        u8 0x1
                        u8 0x2
                    }
                    {
                        u8 0x3
                        u8 username.length
                        string username
                    }
                    {
                        u8 0x4
                        u8 0x4
                        u8[4] our ipaddr
                    }
                    {
                        u8 0x5
                        u8 0x6
                        u8[6] our net card mac
                    }
                    {
                        u8 0x14
                        u8 0x80
                        {
                            _i = (0x2D7 * heartbeat_checksum_sum % 0x35) << 7
                            heartbeat checksum sum = (
                                sum of each byte of next session id +
                                sum of each byte of md5challenge
                            )
                            upper data = cHeartBeatArray[_i:_i + 40]
                            lower data = cHeartBeatArray[_i + 40:_i + 80]
                            LOCAL_md5challenge = {
                                0x17, 0xFE, 0x8D, 0x44, 0x1A, 0x19, 0x09, 0xC0,
                                0xA2, 0xB5, 0x31, 0xD7, 0xA8, 0x0D, 0xC9, 0x91
                            }

                            vz whirlpool as ascii hex of func {
                                switch cHeartBeatArray[_i] % 5 {
                                    case 0:
                                        return (
                                            vz md5 of upper data as ascii hex +
                                            (even bytes of LOCAL_md5challenge) as ascii hex +
                                            vz md5 of lower data as ascii hex +
                                            (odd bytes of LOCAL_md5challenge) as ascii hex
                                        )
                                    case 1:
                                        return (
                                            vz sha1 of lower data +
                                            md5challenge[:6] +
                                            vz sha1 of upper data +
                                            md5challenge[6:]
                                        )
                                    case 2:
                                        return (
                                            vz sha1 of lower data +
                                            md5challenge[:6] +
                                            vz ripemd128 of upper data +
                                            md5challenge[6:]
                                        )
                                    case 3:
                                        return (
                                            vz tiger of upper data +
                                            md5challenge[:10] + // !!!
                                            vz ripemd128 of lower data +
                                            md5challenge[10:]
                                        )
                                    case 4:
                                        return (
                                            vz tiger of upper data +
                                            md5challenge[:8] + // !!!
                                            vz sha1 of lower data +
                                            md5challenge[8:]
                                        )
                                }
                            }
                        }
                    }
                }
            }, false
        }
    } &
} &

daemonize

logout reason = 1

